# ============================================
# DATABASE — NEON POSTGRESQL
# ============================================

DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"


# ============================================
# SERVER & CLIENT URLS
# ============================================

PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:8081"
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:8081"


# ============================================
# AUTHENTICATION & JWT TOKENS
# ============================================

ACCESS_TOKEN_SECRET="your-at-least-32-char-random-access-token-secret"
ACCESS_TOKEN_EXPIRES_IN="15m"

REFRESH_TOKEN_SECRET="your-at-least-32-char-random-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="30d"


# ============================================
# GOOGLE OAUTH 2.0
# ============================================

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8081/api/v1/auth/google/callback"


# ============================================
# TRANSACTIONAL EMAIL (RESEND)
# ============================================

RESEND_API_KEY="re_123456789"
EMAIL_FROM="Settle <no-reply@settle.co>"
EMAIL_FROM_NAME="Settle"
RESEND_OTP_TEMPLATE_ID="published-resend-template-id"


# ============================================
# EPHEMERAL AUTH & RATE LIMITING (REDIS)
# ============================================

REDIS_URL="redis://127.0.0.1:6379"

AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_REQUESTS_PER_HOUR=5


# ============================================
# PASSWORD SECURITY & LOGGING
# ============================================

BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info

