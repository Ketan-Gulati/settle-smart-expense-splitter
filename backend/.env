# Database
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8081

# Authentication
JWT_SECRET="YOUR_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# Security
BCRYPT_SALT_ROUNDS=12

# Logging
LOG_LEVEL=debug