{
  "expo": {
    "name": "Settle",
    "slug": "settle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F172A"
      }
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D14"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Settle",
      "shortName": "Settle",
      "backgroundColor": "#0A0D14",
      "themeColor": "#0A0D14",
      "display": "standalone",
      "orientation": "portrait",
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A0D14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "scheme": "settle"
  }
}